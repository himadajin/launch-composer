{
  "name": "@launch-composer/core",
  "version": "0.1.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "build:test": "node test/build-tests.mjs",
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json",
    "test": "npm run build:test && node --test .test-dist/*.test.js"
  }
}
